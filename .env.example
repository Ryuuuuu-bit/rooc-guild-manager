# Copy this file to .env for local development.
# In production (Railway), set these as environment variables on each
# service instead of committing a .env file — see README.md.

# --- Database (shared by the web app and the bot) ---
# Railway: click the Postgres plugin → "Connect" tab → copy the
# "Postgres Connection URL".
# (do not add a "?schema=" query param — that is a Prisma convention and
# will break postgres.js with "unrecognized configuration parameter")
DATABASE_URL="postgresql://user:password@host:5432/database"

# --- Discord Developer Portal (https://discord.com/developers/applications) ---
# Application → OAuth2 → Client ID / Client Secret
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Application → Bot → Reset Token (keep this secret!). The bot also needs
# the "Server Members Intent" enabled under Bot > Privileged Gateway Intents,
# and must be invited to your server with the "View Channels" permission.
DISCORD_BOT_TOKEN=""

# Right-click your Discord server icon → "Copy Server ID"
# (enable Developer Mode in Discord: User Settings > Advanced > Developer Mode)
DISCORD_GUILD_ID=""

# --- Access control ---
# Comma-separated Discord role IDs whose members should get admin access
# in the web app (right-click a role in Server Settings > Roles > ... > Copy ID).
DISCORD_ADMIN_ROLE_IDS=""

# Optional: comma-separated Discord user IDs that are always admins,
# regardless of role (right-click a user > Copy User ID).
DISCORD_ADMIN_USER_IDS=""

# --- Roster scope ---
# Name of the Discord role that gates who is tracked/shown as a guild
# member. Only people currently holding this role are synced into the
# roster; everyone else in the server is ignored entirely. Matched
# case-insensitively. Defaults to "Rooc" if unset.
DISCORD_TRACKED_ROLE_NAME="Rooc"

# Comma-separated Discord role names to show in the app's role filter and
# role badges (case-insensitive). The Discord server may have many other
# roles (other games, bots, general community tiers) that are just noise
# for guild management — this scopes the UI to the roles that matter here.
# Defaults to "ADMIN,MOD,Rooc,Strategist" if unset.
DISCORD_MANAGEMENT_ROLE_NAMES="ADMIN,MOD,Rooc,Strategist"

# --- Auth.js session encryption ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# In production (Railway), Auth.js sits behind Railway's reverse proxy and
# usually cannot correctly infer its own public URL, which shows up as a
# "https://localhost:8080/login?error=Configuration" redirect. Set BOTH of
# these on the web service to fix it:
AUTH_URL="https://your-app.up.railway.app"
AUTH_TRUST_HOST="true"
